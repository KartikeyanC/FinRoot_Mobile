<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the FinRoot icon: "Add expense" opens the floating Quick Add. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_quick_add"
        android:shortcutShortLabel="@string/quick_add_short"
        android:shortcutLongLabel="@string/quick_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.finroot.mobile"
            android:targetClass="com.finroot.mobile.QuickAddDialogActivity" />
    </shortcut>
</shortcuts>
