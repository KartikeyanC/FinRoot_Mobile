<?xml version="1.0" encoding="utf-8"?>
<!--
  M18 — keep FinRoot's on-device data off Android backup and device transfer.

  The local database is an encrypted, disposable cache of server data; the
  encryption key and the auth session live in the keystore/keychain (not
  backed up). Nothing here should be copied to the cloud or a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
