<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget card: white (light theme) or near-black (dark), warming
     to FinRoot green at the foot. Colours: values[-night]/widget_colors.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/widget_bg_start"
        android:centerColor="@color/widget_bg_center"
        android:endColor="@color/widget_bg_end"
        android:type="linear" />
</shape>
