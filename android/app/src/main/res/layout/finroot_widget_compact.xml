<?xml version="1.0" encoding="utf-8"?>
<!-- FinRoot home-screen widget made two columns wide (FinRootWidget.kt picks
     this layout under WIDE_DP): today's spend, this month's under it, and
     the three buttons as icons only. Same view ids as finroot_widget.xml, so
     the code fills either one the same way.
     RemoteViews only: layouts, TextView and ImageView, no plain View. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_figures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_today"
                android:textColor="@color/widget_text_muted"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/widget_label"
                android:src="@mipmap/ic_launcher" />
        </LinearLayout>

        <!-- Shrinks a long amount to fit two columns rather than cutting it
             (Android 8+; older phones cut it with "…"). -->
        <TextView
            android:id="@+id/widget_today"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_zero"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="@string/widget_month"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_zero"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Budget left this month; hidden with no budget or when the widget is
         two rows tall. -->
    <LinearLayout
        android:id="@+id/widget_budget_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_budget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_soft"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp">

            <ProgressBar
                android:id="@+id/widget_budget_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress" />

            <ProgressBar
                android:id="@+id/widget_budget_bar_over"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/widget_progress_over"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- "Next due: Netflix ₹649 · tomorrow". -->
    <TextView
        android:id="@+id/widget_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_soft"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Takes whatever height the person gives the widget. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp" />

    <!-- Icons only: two columns have no room for the labels. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_pay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button_primary"
                android:contentDescription="@string/widget_pay"
                android:padding="10dp"
                android:src="@drawable/ic_widget_scan_pay" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_bill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button"
                android:tint="@color/widget_button_icon"
                android:contentDescription="@string/widget_bill"
                android:padding="10dp"
                android:src="@drawable/ic_widget_bill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button"
                android:tint="@color/widget_button_icon"
                android:contentDescription="@string/widget_add"
                android:padding="10dp"
                android:src="@drawable/ic_quick_add" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
